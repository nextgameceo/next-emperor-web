# ===== サイトURL（本番ドメインが決まったら設定）=====
# sitemap.xml / OGP / canonical に使われます
NEXT_PUBLIC_SITE_URL=https://example.com

# ===== お問い合わせフォームのメール送信（Resend）=====
# 3つすべて設定されるまで、フォームは「送信先が未設定」と表示し、送信成功を偽装しません。
# 1. https://resend.com でアカウント作成 → API Keys で発行
RESEND_API_KEY=
# 2. お問い合わせを受け取るメールアドレス
CONTACT_TO_EMAIL=
# 3. 送信元（Resendで認証済みドメインのアドレス。例：NEXT EMPEROR <noreply@your-domain.jp>）
CONTACT_FROM_EMAIL=
